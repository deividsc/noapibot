{
    "sqlite": {
        "command": "uvx",
        "args": [
            "mcp-server-sqlite",
            "--db-path",
            "/path/to/your/database.db"
        ]
    },
    "everything": {
        "command": "npx",
        "args": [
            "-y",
            "@modelcontextprotocol/server-everything"
        ]
    },
    "filesystem": {
        "command": "npx",
        "args": [
            "-y",
            "@modelcontextprotocol/server-filesystem",
            "."
        ]
    },
    "puppeteer": {
        "command": "npx",
        "args": [
            "-y",
            "@modelcontextprotocol/server-puppeteer"
        ]
    }
}